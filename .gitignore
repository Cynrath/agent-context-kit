# Node / pnpm
node_modules/
dist/
coverage/

# Test output
*.log
logs/

# Temp files
*.tmp
*.bak

# ACKit local state (generated; never committed)
.ackit/
artifacts/
.ackit-demo/

# Local secrets and environment files
.env
.env.*
secrets.json

# Archives and backups
*.zip
*.rar
*.7z
Backups/
backup/

# OS files
Thumbs.db
.DS_Store

# Editor state
.vscode/
.idea/
*.user
*.suo

# Local screenshots and ephemeral artifacts
webui-*.png
report-*.png

# Legacy tooling leftovers (untracked local state)
.playwright-cli/
.playwright-mcp/
.remember/
graphify-out/

# Benchmark transient fixtures
benchmarks/.fixtures/

# VS Code extension host-test artifacts (generated by pnpm --filter ackit-vscode test)
extensions/vscode/.vscode-test/
extensions/vscode/out/
extensions/vscode/test-fixture/

run-*.txt
full-run.txt

# Session-local temporary artifacts (never committed)
temp/
