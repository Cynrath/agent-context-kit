{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "org": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "pathScopes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^ACKIT\\d{3}$"
          },
          "enabled": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "locked": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "ruleId"
        ]
      }
    },
    "thresholds": {
      "default": {},
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "suppressions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^ACKIT\\d{3}$"
          },
          "pathGlobs": {
            "default": [
              "**"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        },
        "required": [
          "ruleId",
          "reason"
        ]
      }
    },
    "forbiddenPatterns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ACKIT\\d{3}$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "pattern",
          "message"
        ]
      }
    },
    "autonomy": {
      "type": "object",
      "properties": {
        "tier0": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "tier1": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "tier2": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "tier3": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "tier4": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "required": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "correctness",
              "regression",
              "security",
              "tests",
              "architecture",
              "plan-compliance",
              "documentation"
            ]
          }
        },
        "blockingSeverity": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$comment": "ACKit policy document schema v1 (REQ-POL-001)."
}
