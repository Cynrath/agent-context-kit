{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.workflow.v1"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "high-risk"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "task",
        "intent",
        "spec",
        "plan",
        "tasks",
        "implement",
        "verify",
        "review",
        "independent-review",
        "release-evidence"
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stageHistory": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "task",
              "intent",
              "spec",
              "plan",
              "tasks",
              "implement",
              "verify",
              "review",
              "independent-review",
              "release-evidence"
            ]
          },
          "enteredAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "stage",
          "enteredAt"
        ]
      }
    },
    "verificationAttempts": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recordedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "recordedAt",
          "outcome"
        ]
      }
    }
  },
  "required": [
    "schemaId",
    "taskId",
    "profile",
    "stage",
    "createdAt",
    "updatedAt",
    "stageHistory",
    "verificationAttempts"
  ],
  "additionalProperties": false,
  "$comment": "ACKit workflow state schema (ackit.workflow.v1)."
}
