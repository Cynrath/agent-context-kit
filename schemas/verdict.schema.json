{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.verdict.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^VR-\\d{4}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "REWORK_REQUIRED",
        "BLOCKED"
      ]
    },
    "verifier": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "context": {
          "type": "string",
          "enum": [
            "fresh",
            "same"
          ]
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "agent",
        "context",
        "issuedAt"
      ]
    },
    "findings": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "criterion": {
            "type": "string",
            "pattern": "^AC-\\d{3}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ]
      }
    },
    "checkedCriteria": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d{3}$"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "binding": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "stateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "components": {
          "type": "object",
          "properties": {
            "sourceState": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "taskContract": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "intent": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifacts": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workflow": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "config": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sourceState",
            "taskContract",
            "intent",
            "artifacts",
            "workflow",
            "config",
            "policy",
            "evidence"
          ],
          "additionalProperties": false
        },
        "gitUnavailable": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "stateDigest",
        "bundleDigest",
        "components",
        "gitUnavailable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaId",
    "id",
    "taskId",
    "verdict",
    "verifier",
    "findings",
    "checkedCriteria",
    "summary",
    "binding"
  ],
  "additionalProperties": false,
  "$comment": "ACKit state-bound verdict schema (ackit.verdict.v2)."
}
