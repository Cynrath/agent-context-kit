{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.verdict.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^VR-\\d{4}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "REWORK_REQUIRED",
        "BLOCKED"
      ]
    },
    "verifier": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "context": {
          "type": "string",
          "enum": [
            "fresh",
            "same"
          ]
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "agent",
        "context",
        "issuedAt"
      ]
    },
    "findings": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "criterion": {
            "type": "string",
            "pattern": "^AC-\\d{3}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ]
      }
    },
    "checkedCriteria": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d{3}$"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "schemaId",
    "id",
    "taskId",
    "verdict",
    "verifier",
    "findings",
    "checkedCriteria",
    "summary"
  ],
  "additionalProperties": false,
  "$comment": "ACKit verdict schema (ackit.verdict.v1)."
}
