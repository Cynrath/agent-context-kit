{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ackit.handoff.v2"
    },
    "tool": {
      "type": "string",
      "const": "ackit"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-\\d{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            }
          },
          "required": [
            "profile"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "ackit.checkpoint.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^CP-\\d{4}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^TASK-\\d{4}$"
        },
        "workflow": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "quick",
                "standard",
                "high-risk"
              ]
            },
            "stage": {
              "type": "string",
              "enum": [
                "task",
                "intent",
                "spec",
                "plan",
                "tasks",
                "implement",
                "verify",
                "review",
                "independent-review",
                "release-evidence"
              ]
            }
          },
          "required": [
            "profile"
          ]
        },
        "intentRef": {
          "type": "string",
          "pattern": "^INTENT-\\d{4}$"
        },
        "planRef": {
          "type": "string",
          "maxLength": 200
        },
        "completedWork": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "pendingWork": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "decisions": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "failures": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "blockers": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "evidenceRefs": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "changedAreas": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "nextAction": {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string",
              "maxLength": 500
            },
            "path": {
              "type": "string",
              "maxLength": 200
            },
            "command": {
              "type": "string",
              "maxLength": 200
            },
            "expectedResult": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "objective"
          ]
        },
        "gitHead": {
          "type": "string",
          "maxLength": 200
        },
        "gitUnavailable": {
          "default": false,
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "schemaId",
        "id",
        "taskId",
        "workflow",
        "completedWork",
        "pendingWork",
        "decisions",
        "failures",
        "blockers",
        "evidenceRefs",
        "changedAreas",
        "nextAction",
        "gitHead",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "checkpointStaleness": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "problems": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "criterionId": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "present",
        "ok",
        "problems"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "stateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "components": {
          "type": "object",
          "properties": {
            "sourceState": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "taskContract": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "intent": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifacts": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workflow": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "config": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sourceState",
            "taskContract",
            "intent",
            "artifacts",
            "workflow",
            "config",
            "policy",
            "evidence"
          ],
          "additionalProperties": false
        },
        "gitUnavailable": {
          "type": "boolean"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "bound": {
                  "type": "boolean"
                },
                "fresh": {
                  "type": "boolean"
                },
                "problemCode": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "changed": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "independent": {
                  "type": "boolean"
                },
                "reviewedBundleDigest": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "independenceCode": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "value",
                "bound",
                "fresh",
                "problemCode",
                "changed",
                "independent",
                "reviewedBundleDigest",
                "independenceCode"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stateDigest",
        "bundleDigest",
        "components",
        "gitUnavailable",
        "verdict"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "blockers": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "next": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "command": {
                "type": "string",
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "action",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "blockers",
        "next"
      ],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "string",
          "const": "asserted-absent"
        },
        "secretGate": {
          "type": "string",
          "const": "ackit-canonical"
        },
        "absolutePaths": {
          "type": "string",
          "const": "scrubbed"
        },
        "scrubbedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "secrets",
        "secretGate",
        "absolutePaths",
        "scrubbedCount"
      ],
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "const": "provider-neutral"
        },
        "steps": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "required": [
        "audience",
        "steps"
      ],
      "additionalProperties": false
    },
    "markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256000
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "task",
    "workflow",
    "checkpoint",
    "checkpointStaleness",
    "evidence",
    "verification",
    "status",
    "redaction",
    "instructions",
    "markdown"
  ],
  "additionalProperties": false,
  "$comment": "ACKit portable handoff schema (ackit.handoff.v2)."
}
