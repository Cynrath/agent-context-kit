{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cynrath.github.io/agent-context-kit/schemas/instruction-graph.schema.json",
  "title": "Instruction Graph v2",
  "description": "Instruction graph v2 (REQ-V020-D-001) — deterministic ordering, provenance, shadow/duplicate scope.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number",
      "description": "Graph schema version"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "codex",
              "claude",
              "gemini",
              "copilot",
              "shared"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "instruction",
              "skill"
            ]
          },
          "relativePath": {
            "type": "string"
          },
          "scopeRoot": {
            "type": "string"
          },
          "applyTo": {
            "default": null,
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "precedence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "managed": {
            "type": "boolean"
          },
          "checksum": {
            "type": "string"
          },
          "tokenEstimate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable",
              "broken-reference",
              "oversized"
            ]
          },
          "conflicts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "securityFlags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "external-link",
                "root-escape-reference",
                "hidden-unicode"
              ]
            }
          },
          "includeScopes": {
            "default": null,
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "excludeScopes": {
            "default": null,
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "providerApplicability": {
            "default": null,
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude",
                    "gemini",
                    "copilot",
                    "shared"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "source",
                "reason"
              ]
            }
          },
          "orderIndex": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shadowedBy": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "duplicateOf": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "provider",
          "kind",
          "relativePath",
          "scopeRoot",
          "depth",
          "precedence",
          "managed",
          "checksum",
          "tokenEstimate",
          "status"
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "relativePath": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "nodes",
    "diagnostics"
  ],
  "additionalProperties": false
}
