{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.evidence.v2"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "criteria": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d{3}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "evidence": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "test",
                    "build",
                    "lint",
                    "typecheck",
                    "benchmark",
                    "runtime",
                    "e2e",
                    "ci",
                    "git",
                    "static-analysis",
                    "security-scan",
                    "manual",
                    "external",
                    "verifier-verdict"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "recordedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "type",
                "ref",
                "recordedAt"
              ]
            }
          }
        },
        "required": [
          "id",
          "requirement",
          "status",
          "evidence"
        ]
      }
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schemaId",
    "taskId",
    "criteria",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$comment": "ACKit evidence registry schema (ackit.evidence.v2)."
}
