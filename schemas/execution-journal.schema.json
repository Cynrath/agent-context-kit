{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.execution-journal.v1"
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task-transition",
        "ackit-command",
        "policy-decision",
        "evidence-registered",
        "verdict-registered",
        "checkpoint-created",
        "workflow-stage",
        "verification-attempt"
      ]
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "detail": {}
  },
  "required": [
    "schemaId",
    "seq",
    "occurredAt",
    "kind",
    "detail"
  ],
  "$comment": "ACKit execution journal event schema (ackit.execution-journal.v1)."
}
