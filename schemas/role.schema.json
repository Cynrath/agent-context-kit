{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "ackit.role.v1"
    },
    "role": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requiredInputs": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "intent",
          "spec",
          "plan",
          "task",
          "diff",
          "tests",
          "evidence",
          "verdict"
        ]
      }
    },
    "allowedActions": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "forbiddenActions": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "requiredOutputs": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "outputSchema": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "schemaId",
    "role",
    "title",
    "description"
  ],
  "additionalProperties": false,
  "$comment": "ACKit role contract schema (ackit.role.v1)."
}
