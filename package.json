{
  "name": "@cynrath/agent-context-kit",
  "version": "0.5.4",
  "description": "Agent context and repository readiness toolkit for Codex, Claude Code, Cursor, Copilot, Gemini and MCP-based coding agents. Validates agent instructions, scans repositories, optimizes context and enforces evidence-backed workflows. Offline-first and deterministic.",
  "keywords": [
    "ackit",
    "agent-context",
    "agents-md",
    "agent-instructions",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "github-copilot",
    "gemini",
    "context-engineering",
    "repository-readiness",
    "ai-agent-tooling",
    "instruction-graph",
    "agent-skills",
    "security-scanner",
    "context-budget",
    "task-workflow",
    "policy-as-code",
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "offline-first",
    "deterministic"
  ],
  "homepage": "https://github.com/Cynrath/agent-context-kit",
  "bugs": {
    "url": "https://github.com/Cynrath/agent-context-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynrath/agent-context-kit.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ackit": "./dist/cli/index.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build && pnpm gen:schemas",
    "gen:schemas": "node scripts/generate-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests scripts schemas examples",
    "format:check": "biome format src tests scripts schemas examples",
    "format": "biome format --write src tests scripts schemas examples",
    "test": "vitest run",
    "check:text-hygiene": "node scripts/check-text-hygiene.mjs --repo",
    "smoke:cli": "node tests/e2e/cli-scaffold.smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.6",
    "picomatch": "^4.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.10.9",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
