<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentContextKit.Core\AgentContextKit.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ackit</ToolCommandName>
    <PackageId>AgentContextKit</PackageId>
    <Version>1.0.0-rc.1</Version>
    <Authors>Cynrath</Authors>
    <Company>Cynrath</Company>
    <Copyright>Copyright (c) 2026 Cynrath</Copyright>
    <Description>Offline-first repository context and safety tooling for AI-assisted development.</Description>
    <!-- NuGet renders the dedicated pure-Markdown source; keep GitHub-only HTML/layout in README.md. -->
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;coding-agent;context;security;cli;oss</PackageTags>
    <PackageReleaseNotes>1.0.0-rc.1 candidate: freezes the CLI, config, baseline, JSON, SARIF, localization, security-ownership, and upgrade contracts for final hosted validation. Publication and publish-path provenance remain pending.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Cynrath/agent-context-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cynrath/agent-context-kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
