{
  "name": "ackit-vscode",
  "displayName": "ACKit Toolkit",
  "description": "Offline-first agent readiness toolkit for VS Code",
  "version": "0.4.1",
  "publisher": "Cynrath",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "ackit",
    "agent-readiness",
    "context",
    "offline-first",
    "linter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ackit.refresh",
        "title": "ACKit: Refresh"
      },
      {
        "command": "ackit.showGraph",
        "title": "ACKit: Show Graph"
      },
      {
        "command": "ackit.showReadiness",
        "title": "ACKit: Show Readiness"
      },
      {
        "command": "ackit.openFinding",
        "title": "ACKit: Open Finding"
      },
      {
        "command": "ackit.instructionsForCurrentFile",
        "title": "ACKit: Instructions for Current File"
      },
      {
        "command": "ackit.optimize",
        "title": "ACKit: Optimize"
      },
      {
        "command": "ackit.diagnostics",
        "title": "ACKit: Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ackit",
          "title": "ACKit",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "ackit": [
        {
          "type": "tree",
          "id": "ackit.readiness",
          "name": "Readiness"
        },
        {
          "type": "tree",
          "id": "ackit.findings",
          "name": "Findings"
        },
        {
          "type": "tree",
          "id": "ackit.graph",
          "name": "Instruction Graph"
        },
        {
          "type": "tree",
          "id": "ackit.tasks",
          "name": "Tasks"
        },
        {
          "type": "tree",
          "id": "ackit.policy",
          "name": "Policy"
        },
        {
          "type": "tree",
          "id": "ackit.optimize",
          "name": "Optimize"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --outfile=dist/extension.js --external:vscode --sourcemap",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile:test && node ./out/test/runTest.js",
    "pretest": "npm run compile:test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.23.0",
    "glob": "^10.5.0",
    "mocha": "^10.8.2",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cynrath/agent-context-kit.git"
  },
  "homepage": "https://cynrath.github.io/agent-context-kit/",
  "bugs": {
    "url": "https://github.com/Cynrath/agent-context-kit/issues"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "dependencies": {
    "@cynrath/agent-context-kit": "workspace:*"
  }
}
