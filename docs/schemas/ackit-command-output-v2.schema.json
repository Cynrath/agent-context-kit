{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cynrath/agent-context-kit/blob/master/docs/schemas/ackit-command-output-v2.schema.json",
  "title": "AgentContextKit command output schema v2",
  "description": "Normative top-level contract for JSON-capable ackit commands. Additional properties are allowed for backward-compatible additive evolution.",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolVersion",
    "generatedAtUtc",
    "command"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "command": {
      "type": "string",
      "enum": [
        "init",
        "config-check",
        "scan",
        "optimize",
        "baseline",
        "sarif",
        "report",
        "webui",
        "prompt-pack",
        "context-export",
        "generate",
        "task",
        "redact-check",
        "doctor"
      ]
    },
    "repositoryPath": { "type": "string" },
    "repositoryName": { "type": "string", "minLength": 1 },
    "ciMode": { "type": "boolean" },
    "exitCode": { "type": "integer", "enum": [0, 1, 2] },
    "format": { "type": "string", "enum": ["json"] },
    "output": { "$ref": "#/$defs/generatedFile" },
    "auditSummary": { "$ref": "#/$defs/instructionAuditSummary" },
    "instructionMetrics": { "$ref": "#/$defs/instructionMetrics" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/instructionSource" } },
    "scopes": { "type": "array", "items": { "$ref": "#/$defs/instructionScope" } },
    "scopedOverrides": { "type": "array", "items": { "$ref": "#/$defs/scopedOverride" } },
    "instructionFindings": { "type": "array", "items": { "$ref": "#/$defs/instructionFinding" } },
    "fileCount": { "type": "integer", "minimum": 0 },
    "target": { "type": "string" },
    "profile": { "type": "string" },
    "criticalHighCount": { "type": "integer", "minimum": 0 },
    "config": { "type": "object", "additionalProperties": true },
    "agentInstructionFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "diagnosticSummary": { "$ref": "#/$defs/diagnosticSummary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/configDiagnostic" }
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "signal"],
        "properties": {
          "name": { "type": "string" },
          "signal": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "health": { "type": "object", "additionalProperties": true },
    "riskSummary": { "$ref": "#/$defs/riskSummary" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "suppressionSummary": { "type": "object", "additionalProperties": true },
    "suppressions": { "type": "array", "items": { "type": "object" } },
    "baseline": { "type": "object", "additionalProperties": true },
    "sarif": { "$ref": "#/$defs/generatedFile" },
    "report": { "$ref": "#/$defs/generatedFile" },
    "webUi": { "$ref": "#/$defs/generatedFile" },
    "promptPack": { "$ref": "#/$defs/generatedFile" },
    "contextExport": { "$ref": "#/$defs/generatedFile" },
    "file": { "$ref": "#/$defs/generatedFile" },
    "fileSummary": { "$ref": "#/$defs/fileSummary" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/generatedFile" } },
    "checkSummary": { "$ref": "#/$defs/checkSummary" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "init" } }, "required": ["command"] },
      "then": { "required": ["config", "agentInstructionFiles"] }
    },
    {
      "if": { "properties": { "command": { "const": "config-check" } }, "required": ["command"] },
      "then": { "required": ["repositoryName", "exitCode", "config", "diagnosticSummary", "diagnostics"] }
    },
    {
      "if": { "properties": { "command": { "const": "scan" } }, "required": ["command"] },
      "then": { "required": ["ciMode", "exitCode", "repositoryPath", "repositoryName", "fileCount", "stacks", "health", "riskSummary", "findings", "suppressionSummary", "suppressions"] }
    },
    {
      "if": { "properties": { "command": { "const": "optimize" } }, "required": ["command"] },
      "then": { "required": ["repositoryName", "ciMode", "exitCode", "format", "output", "auditSummary", "instructionMetrics", "sources", "scopes", "scopedOverrides", "instructionFindings"] }
    },
    {
      "if": { "properties": { "command": { "const": "baseline" } }, "required": ["command"] },
      "then": { "required": ["repositoryName", "baseline"] }
    },
    {
      "if": { "properties": { "command": { "const": "sarif" } }, "required": ["command"] },
      "then": { "required": ["repositoryName", "riskSummary", "criticalHighCount", "sarif"] }
    },
    {
      "if": { "properties": { "command": { "const": "report" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "riskSummary", "report"] }
    },
    {
      "if": { "properties": { "command": { "const": "webui" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "riskSummary", "webUi"] }
    },
    {
      "if": { "properties": { "command": { "const": "prompt-pack" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "riskSummary", "promptPack"] }
    },
    {
      "if": { "properties": { "command": { "const": "context-export" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "riskSummary", "contextExport"] }
    },
    {
      "if": { "properties": { "command": { "const": "generate" } }, "required": ["command"] },
      "then": { "required": ["target", "fileSummary", "files"] }
    },
    {
      "if": { "properties": { "command": { "const": "task" } }, "required": ["command"] },
      "then": { "required": ["file"] }
    },
    {
      "if": { "properties": { "command": { "const": "redact-check" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "profile", "exitCode", "riskSummary", "findings"] }
    },
    {
      "if": { "properties": { "command": { "const": "doctor" } }, "required": ["command"] },
      "then": { "required": ["repositoryPath", "repositoryName", "exitCode", "checkSummary", "checks"] }
    }
  ],
  "$defs": {
    "generatedFile": {
      "type": "object",
      "required": ["path", "status", "created", "message"],
      "properties": {
        "path": { "type": "string" },
        "status": { "type": "string" },
        "created": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "riskSummary": {
      "type": "object",
      "required": ["total", "critical", "high", "medium", "low", "info"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["ruleId", "severity", "category", "path", "message", "match"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^ACKIT[0-9]{3}$" },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "match": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "instructionAuditSummary": {
      "type": "object",
      "required": ["sourceCount", "ruleCount", "scopeCount", "scopedOverrideCount", "findingCount", "deterministicCount", "heuristicCount", "severity"],
      "properties": {
        "sourceCount": { "type": "integer", "minimum": 0 },
        "ruleCount": { "type": "integer", "minimum": 0 },
        "scopeCount": { "type": "integer", "minimum": 0 },
        "scopedOverrideCount": { "type": "integer", "minimum": 0 },
        "findingCount": { "type": "integer", "minimum": 0 },
        "deterministicCount": { "type": "integer", "minimum": 0 },
        "heuristicCount": { "type": "integer", "minimum": 0 },
        "severity": { "$ref": "#/$defs/riskSummary" }
      },
      "additionalProperties": true
    },
    "contentMetrics": {
      "type": "object",
      "required": ["characters", "words", "lines", "estimatedTokens"],
      "properties": {
        "characters": { "type": "integer", "minimum": 0 },
        "words": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "instructionMetrics": {
      "type": "object",
      "required": ["total", "duplicated", "avoidable", "estimationMethod"],
      "properties": {
        "total": { "$ref": "#/$defs/contentMetrics" },
        "duplicated": { "$ref": "#/$defs/contentMetrics" },
        "avoidable": { "$ref": "#/$defs/contentMetrics" },
        "estimationMethod": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "instructionSource": {
      "type": "object",
      "required": ["path", "type", "directoryScope", "precedence", "appliesToDescendants", "inheritedApplicability", "metrics", "ruleCount"],
      "properties": {
        "path": { "type": "string" },
        "type": { "type": "string" },
        "directoryScope": { "type": "string" },
        "precedence": { "type": "integer" },
        "appliesToDescendants": { "type": "boolean" },
        "inheritedApplicability": { "type": "string" },
        "metrics": { "$ref": "#/$defs/contentMetrics" },
        "ruleCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "instructionScope": {
      "type": "object",
      "required": ["directoryScope", "applicableSourcePaths", "scopedOverrideCount"],
      "properties": {
        "directoryScope": { "type": "string" },
        "applicableSourcePaths": { "type": "array", "items": { "type": "string" } },
        "scopedOverrideCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "instructionLocation": {
      "type": "object",
      "required": ["path", "startLine", "endLine", "directoryScope"],
      "properties": {
        "path": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "directoryScope": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scopedOverride": {
      "type": "object",
      "required": ["directoryScope", "broaderRule", "narrowerRule", "reason"],
      "properties": {
        "directoryScope": { "type": "string" },
        "broaderRule": { "$ref": "#/$defs/instructionLocation" },
        "narrowerRule": { "$ref": "#/$defs/instructionLocation" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "instructionFinding": {
      "type": "object",
      "required": ["ruleId", "fingerprint", "severity", "category", "sourceFile", "startLine", "endLine", "directoryScope", "explanation", "evidence", "remediation", "deterministic", "heuristic", "relatedLocations"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^ACKITOPT[0-9]{3}$" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "sourceFile": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "directoryScope": { "type": "string" },
        "explanation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "heuristic": { "type": "boolean" },
        "relatedLocations": { "type": "array", "items": { "$ref": "#/$defs/instructionLocation" } }
      },
      "additionalProperties": true
    },
    "diagnosticSummary": {
      "type": "object",
      "required": ["total", "info", "warnings", "errors"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "configDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "line", "key", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^ACKITCFG[0-9]{3}$" },
        "severity": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "key": { "type": ["string", "null"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "fileSummary": {
      "type": "object",
      "required": ["total", "created", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "checkSummary": {
      "type": "object",
      "required": ["total", "passed", "failed", "failedHighOrCritical"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "failedHighOrCritical": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["name", "severity", "passed", "message"],
      "properties": {
        "name": { "type": "string" },
        "severity": { "type": "string" },
        "passed": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
